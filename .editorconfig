# loreos — single source of truth for formatting and analyzer severities.
# constitution.md §5: formatting and analyzers are gates, not suggestions.
# Analyzer noise is tuned HERE, not via NoWarn in project files.

root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.{js,jsx,ts,tsx,css,scss,html}]
indent_size = 2

[*.{csproj,props,targets,sln}]
indent_size = 2

[*.py]
indent_size = 4

#### C# ####

[*.cs]
# --- whitespace / new-line conventions (enforced by `dotnet format`) ---
csharp_new_line_before_open_brace = all
csharp_new_line_before_else = true
csharp_new_line_before_catch = true
csharp_new_line_before_finally = true
csharp_indent_case_contents = true
csharp_indent_switch_labels = true
csharp_space_after_keywords_in_control_flow_statements = true
csharp_space_between_method_declaration_parameter_list_parentheses = false
csharp_preserve_single_line_statements = false

# --- using directives ---
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# --- code style (IDE rules build as errors via EnforceCodeStyleInBuild +
#     TreatWarningsAsErrors when severity >= warning) ---
csharp_style_namespace_declarations = file_scoped:warning
csharp_prefer_braces = true:warning
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion
dotnet_style_qualification_for_event = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_prefer_auto_properties = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion

# --- naming: interface prefix enforced at warning strength (build error via TreatWarningsAsErrors) ---
dotnet_naming_rule.interfaces_begin_with_i.severity = warning
dotnet_naming_rule.interfaces_begin_with_i.symbols = interfaces
dotnet_naming_rule.interfaces_begin_with_i.style = begins_with_i
dotnet_naming_symbols.interfaces.applicable_kinds = interface
dotnet_naming_style.begins_with_i.required_prefix = I
dotnet_naming_style.begins_with_i.capitalization = pascal_case

# --- analyzer severity tuning (the agreed baseline; spec 001 plan.md) ---
# CA1303: literal strings as localized parameters — Lore is not localized.
dotnet_diagnostic.CA1303.severity = none
# CA1014: mark assemblies CLSCompliant — not a goal for an application repo.
dotnet_diagnostic.CA1014.severity = none
# CA1848/CA2254: LoggerMessage delegates — revisit when logging arrives (003+).
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA2254.severity = suggestion
