# Normalize all text files to LF in the repository; working-tree line endings
# follow each contributor's core.autocrlf. Binary types are marked explicitly.
* text=auto

*.cs    text diff=csharp
*.csproj text
*.props  text
*.targets text
*.sln   text eol=crlf
*.py    text
*.ts    text
*.tsx   text
*.js    text
*.json  text
*.md    text
*.yml   text
*.yaml  text
*.toml  text

*.png   binary
*.jpg   binary
*.gif   binary
*.ico   binary
*.zip   binary
*.exe   binary
*.dll   binary
