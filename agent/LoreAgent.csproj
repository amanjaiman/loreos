<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the capture pipeline (spec 003) uses UI Automation (needs WPF
         assemblies) for primary text extraction and the OS-native Windows.Media.Ocr
         engine for the fallback — the latter needs a Windows SDK-versioned TFM so the
         WinRT projections (Windows.*) are available. 10.0.19041 is the floor that ships
         Windows.Media.Ocr and is present on every CI windows runner. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lore.Agent</RootNamespace>
    <AssemblyName>LoreAgent</AssemblyName>
    <!-- The capture pipeline's Win32 seam (spec 003) uses source-generated P/Invoke
         (LibraryImport); its generated marshalling stubs require unsafe blocks. This
         enables the generator only — the hand-written agent code stays safe. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The agent host is an ASP.NET Core minimal-API app (spec 002 T005): the local
         API on 127.0.0.1 that every surface is a client of (constitution §3.1). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Thin local operational store for capture telemetry (spec 003 T007): the
         human-readable activity log + raw captures the user can inspect. This is NOT
         mem0 — it never leaves the machine. Bundle build includes native SQLite. -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <!-- Generated OpenAPI document for the local API (spec 005 T007): the contract
         surfaces (006/007/010) pin to, served at /openapi.json. .NET 8 has no built-in
         document endpoint, so Swashbuckle generates it from the minimal-API metadata. -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests drive the capture loop's per-tick pipeline (CaptureAgent.CaptureOnceAsync),
         which is internal so it isn't part of the public surface. -->
    <InternalsVisibleTo Include="LoreAgent.Tests" />
  </ItemGroup>

</Project>
