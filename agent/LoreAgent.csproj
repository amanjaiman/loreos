<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows-only: the capture pipeline (spec 003) uses UI Automation, which
         needs WPF assemblies. Set here once so the csproj baseline is stable. -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Lore.Agent</RootNamespace>
    <AssemblyName>LoreAgent</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- The agent host is an ASP.NET Core minimal-API app (spec 002 T005): the local
         API on 127.0.0.1 that every surface is a client of (constitution §3.1). -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
