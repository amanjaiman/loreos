<Project>

  <!-- Single source of truth for the product version (spec 012 T001).
       This <Version> drives the agent assembly version, which is what
       GET /system/status reports (agent/Api/Endpoints/SystemEndpoints.cs reads
       AssemblyInformationalVersion). app/package.json must carry the SAME value
       (it names the Squirrel installer artifact). They are kept in lockstep by:
         - a release build injecting the tag version into BOTH (the release
           workflow writes ${GITHUB_REF_NAME#v} here and into package.json), and
         - LoreAgent.Tests VersionSyncTests, which fails the build if the agent
           assembly version and app/package.json drift.
       The committed value is the in-development version; the tag is authoritative
       at release time. Bump this and package.json together when not tagging. -->
  <PropertyGroup>
    <Version>0.1.5</Version>
  </PropertyGroup>

  <!-- Shared build properties for every C# project in the solution.
       constitution.md §5: formatting and analyzers are gates, not suggestions. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>8.0</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
